    SPDX-License-Identifier: OSL-3.0 OR AFL-3.0

    Send Through the Queue: the message is the Email Log entry to send
    ({"log_id": 12, "attempt": 1}); the entry keeps the email itself.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Communication/etc/communication.xsd">
    <topic name="zero.mail.send" request="string">
        <handler name="zero_mail_send" type="Zero\Mail\Model\Queue\Consumer" method="process"/>
    </topic>
</config>
