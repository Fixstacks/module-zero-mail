{
    "name": "zerofront/module-zero-mail",
    "description": "Zero for Magento Open Source: email transport (Magento's own or Amazon SES), sent now or through a queue (RabbitMQ or the database), an email log with Resend, one sender, a test email.",
    "type": "magento2-module",
    "version": "1.3.3",
    "license": [
        "OSL-3.0",
        "AFL-3.0"
    ],
    "authors": [
        {
            "name": "Roman Pasichnyk"
        }
    ],
    "homepage": "https://zerofront.dev",
    "keywords": [
        "magento",
        "magento2",
        "magento-open-source",
        "zero",
        "email",
        "amazon-ses",
        "email-log"
    ],
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "103.0.*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-email": "*",
        "magento/module-store": "*",
        "magento/module-ui": "*",
        "zerofront/module-zero-core": "^1.3"
    },
    "replace": {
        "fixstacks/module-zero-mail": "self.version"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Zero\\Mail\\": ""
        }
    }
}
